{
  "name": "multisales-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour le projet MULTISALES (multisales-18e57)",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint . || true",
    "test": "mocha --exit --reporter mocha-junit-reporter --reporter-options mochaFile=./test-results/junit.xml",
    "emulators": "firebase emulators:start --only firestore,functions,auth,storage",
    "emulators:ci": "firebase emulators:exec --only firestore,functions,auth,storage \"npm test\"",
    "deploy": "firebase deploy --only functions --project=multisales-18e57"
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1",
    "googleapis": "^139.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "eslint": "^8.50.0",
    "firebase-functions-test": "^0.3.3",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^15.0.0",
    "zod": "^3.23.8"
  }
}
